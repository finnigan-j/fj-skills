#!/bin/bash
# Install (or reinstall) the weekly claude-backup systemd *user* timer.
# Idempotent. Usage: install-systemd [--uninstall]
# Authored on macOS and syntax-checked only; verify with `systemctl --user list-timers`.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(git -C "$script_dir" rev-parse --show-toplevel)"
src="$repo/claude-backup/systemd"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

if [ "${1:-}" = "--uninstall" ]; then
  systemctl --user disable --now claude-backup.timer 2>/dev/null || true
  rm -f "$unit_dir/claude-backup.service" "$unit_dir/claude-backup.timer"
  systemctl --user daemon-reload
  echo "removed claude-backup.timer"
  exit 0
fi

for f in claude-backup.service claude-backup.timer; do
  [ -f "$src/$f" ] || { echo "template missing: $src/$f" >&2; exit 1; }
done
mkdir -p "$unit_dir"
sed -e "s|__REPO__|$repo|g" "$src/claude-backup.service" > "$unit_dir/claude-backup.service"
cp "$src/claude-backup.timer" "$unit_dir/claude-backup.timer"
systemctl --user daemon-reload
systemctl --user enable --now claude-backup.timer

echo "installed claude-backup.timer -> $unit_dir"
echo "schedule : $(grep -E '^OnCalendar=' "$unit_dir/claude-backup.timer" | cut -d= -f2-) (local time)"
echo "script   : $repo/claude-backup/bin/claude-backup"
echo "run now  : systemctl --user start claude-backup.service"
echo "logs     : journalctl --user -u claude-backup"
echo "note     : run 'loginctl enable-linger $USER' once so the timer fires without a login session"
